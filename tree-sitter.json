{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gofra",
      "camelcase": "Gofra",
      "title": "Gofra",
      "scope": "source.gofra",
      "file-types": [
        "gof",
        "gofra"
      ],
      "injection-regex": "^gofra$",
      "class-name": "TreeSitterGofra"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Gofra grammar for tree-sitter",
    "authors": [
      {
        "name": "Kirill Zhosul",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-gofra",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}